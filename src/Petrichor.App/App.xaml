<Application x:Class="Petrichor.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" RequestedTheme="Dark">
 <Application.Resources><ResourceDictionary>
  <SolidColorBrush x:Key="ApplicationForegroundThemeBrush" Color="#ECECEF"/><Color x:Key="SystemAccentColor">#E84757</Color><SolidColorBrush x:Key="Accent" Color="#E84757" /><SolidColorBrush x:Key="SecondaryText" Color="#96969F" /><SolidColorBrush x:Key="PageBackground" Color="#0B0B0C" /><SolidColorBrush x:Key="Surface" Color="#151517" />
  <Style x:Key="PageTitle" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI Light" /><Setter Property="FontSize" Value="30" /><Setter Property="Margin" Value="0,0,0,12" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="FontSize" Value="10" /><Setter Property="Foreground" Value="{StaticResource SecondaryText}" /><Setter Property="CharacterSpacing" Value="220" /><Setter Property="Margin" Value="0,8,0,4" /></Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI Light" /><Setter Property="FontSize" Value="20" /><Setter Property="Margin" Value="0,20,0,12" /></Style>
  <Style x:Key="MetroButton" TargetType="Button"><Setter Property="MinHeight" Value="44" /><Setter Property="MinWidth" Value="44" /><Setter Property="Padding" Value="12,8" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="HorizontalContentAlignment" Value="Center" /></Style>
  <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource MetroButton}"><Setter Property="Background" Value="{StaticResource Accent}" /></Style>
  <DataTemplate x:Key="MusicRowTemplate"><Grid Padding="0,8" MinHeight="72"><Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /></Grid.ColumnDefinitions><Border Width="44" Height="44" Background="{StaticResource Surface}"><Image Source="{Binding Cover}" Stretch="UniformToFill" /></Border><StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontSize="15" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" /></StackPanel><FontIcon Grid.Column="2" Glyph="&#xE73E;" FontSize="12" Foreground="{StaticResource SecondaryText}" Visibility="{Binding CacheVisibility}" VerticalAlignment="Center" HorizontalAlignment="Right" AutomationProperties.Name="已缓存" ToolTipService.ToolTip="已缓存，可离线播放"/></Grid></DataTemplate>
  <Style x:Key="CoverItemStyle" TargetType="GridViewItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style><DataTemplate x:Key="CoverTemplate"><StackPanel Width="{Binding TileWidth}" Margin="0,0,12,16"><Border Width="{Binding TileWidth}" Height="{Binding TileWidth}" Background="{StaticResource Surface}"><Image Source="{Binding Cover}" Stretch="UniformToFill" /></Border><TextBlock Text="{Binding Title}" FontSize="13" TextWrapping="Wrap" MaxLines="2" Margin="0,7,0,4" /><TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" /></StackPanel></DataTemplate>
 <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/></Style>
<DataTemplate x:Key="CommentTemplate"><Grid Padding="0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="{Binding Avatar}" Width="32" Height="32" VerticalAlignment="Top" Stretch="UniformToFill"/><StackPanel Grid.Column="1"><Grid><TextBlock Text="{Binding Nickname}" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,0,50,0"/><TextBlock Text="{Binding Likes}" FontSize="12" Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Right"/></Grid><TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="15" LineHeight="23" Margin="0,8,0,8"/><TextBlock Text="{Binding DateText}" FontSize="11" Foreground="{StaticResource SecondaryText}"/></StackPanel></Grid></DataTemplate></ResourceDictionary></Application.Resources>
</Application>



