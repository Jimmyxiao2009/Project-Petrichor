<Page x:Class="Petrichor.App.Shell" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource PageBackground}">
 <Grid><Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition x:Name="MiniPlayerRow" Height="60" /><RowDefinition Height="58" /></Grid.RowDefinitions>
  <ProgressBar x:Name="Busy" Height="3" VerticalAlignment="Top" IsIndeterminate="True" Visibility="Collapsed" Canvas.ZIndex="5" Foreground="{StaticResource Accent}"/><Frame x:Name="ContentFrame" HorizontalAlignment="Stretch" Navigated="OnNavigated" />
  <Border x:Name="Notice" Grid.Row="1" Background="#292126" Visibility="Collapsed" Padding="14,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions><TextBlock x:Name="NoticeText" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" /><Button Grid.Column="1"  Click="DismissNotice" Style="{StaticResource MetroButton}" AutomationProperties.Name="关闭提示"><FontIcon Glyph="&#xE711;" FontSize="16"/></Button></Grid></Border>
  <Border x:Name="MiniPlayer" Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="#252528" BorderThickness="0,1,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions><Button x:Name="MiniOpen" Click="OpenPlayer" Padding="12,6" HorizontalContentAlignment="Stretch" Style="{StaticResource MetroButton}" AutomationProperties.Name="打开正在播放"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Image x:Name="MiniCover" Source="Assets/Forest.png" Width="40" Height="40" Stretch="UniformToFill" /><StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="MiniTitle" Text="让音乐陪你走一段路" FontSize="13" TextTrimming="CharacterEllipsis" /><TextBlock x:Name="MiniArtist" Text="选择一首歌，开始播放" FontSize="10" Foreground="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" /></StackPanel></Grid></Button><Button Grid.Column="1" x:Name="MiniToggle" Click="TogglePlayback" Style="{StaticResource MetroButton}" AutomationProperties.Name="播放或暂停"><FontIcon x:Name="MiniPlayGlyph" Glyph="&#xE768;" FontSize="20" /></Button><Button Grid.Column="2" Click="OpenQueue" Style="{StaticResource MetroButton}" AutomationProperties.Name="播放队列"><FontIcon Glyph="&#xE8FD;" FontSize="20" /></Button></Grid></Border>
  <Grid Grid.Row="3" Background="#0F0F11"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button x:Name="DiscoverNav" Click="NavigateDiscover" HorizontalAlignment="Stretch" Style="{StaticResource MetroButton}"><StackPanel><FontIcon Glyph="&#xE80F;" FontSize="20" /><TextBlock Text="发现" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" /></StackPanel></Button><Button x:Name="SearchNav" Grid.Column="1" Click="NavigateSearch" HorizontalAlignment="Stretch" Style="{StaticResource MetroButton}"><StackPanel><FontIcon Glyph="&#xE721;" FontSize="20" /><TextBlock Text="搜索" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" /></StackPanel></Button><Button x:Name="LibraryNav" Grid.Column="2" Click="NavigateLibrary" HorizontalAlignment="Stretch" Style="{StaticResource MetroButton}"><StackPanel><FontIcon Glyph="&#xE8D6;" FontSize="20" /><TextBlock Text="我的" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" /></StackPanel></Button><Button x:Name="SettingsNav" Grid.Column="3" Click="NavigateSettings" HorizontalAlignment="Stretch" Style="{StaticResource MetroButton}"><StackPanel><FontIcon Glyph="&#xE712;" FontSize="20" /><TextBlock Text="更多" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" /></StackPanel></Button></Grid>
 </Grid></Grid>
</Page>



