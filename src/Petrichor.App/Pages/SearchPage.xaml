<base:MusicPage x:Class="Petrichor.App.Pages.SearchPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:base="using:Petrichor.App">
  <Grid Margin="20,20,20,8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock x:Name="Title" Text="搜索" Style="{StaticResource PageTitle}" />
    </StackPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="64" />
      </Grid.ColumnDefinitions>
      <TextBox x:Name="Query" PlaceholderText="歌曲、歌手、专辑或歌单" KeyDown="QueryKeyDown" AutomationProperties.Name="搜索关键词" />
      <Button Grid.Column="1" Click="SubmitClick" Style="{StaticResource AccentButton}">
        <base:IconLabel Glyph="" Text="搜索" />
      </Button>
    </Grid>
    <StackPanel Grid.Row="2">
      <ComboBox x:Name="Kind" SelectedIndex="0" SelectionChanged="KindChanged" Margin="0,12,0,8" HorizontalAlignment="Stretch">
        <ComboBoxItem Content="单曲" />
        <ComboBoxItem Content="歌单" />
        <ComboBoxItem Content="歌手" />
        <ComboBoxItem Content="专辑" />
      </ComboBox>
      <TextBlock x:Name="Status" Text="输入关键词，寻找下一首喜欢的音乐。" TextWrapping="Wrap" Foreground="{StaticResource SecondaryText}" />
    </StackPanel>
    <ListView Grid.Row="3" x:Name="Results" ItemTemplate="{StaticResource MusicRowTemplate}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="ResultClick" />
    <Button Grid.Row="4" x:Name="More" Click="MoreClick" Visibility="Collapsed" Style="{StaticResource MetroButton}">
      <base:IconLabel Glyph="" Text="加载更多" />
    </Button>
  </Grid>
</base:MusicPage>
