<base:MusicPage x:Class="Petrichor.App.Pages.LibraryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:base="using:Petrichor.App">
<Grid Margin="20,20,20,8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
<TextBlock Text="我的" Style="{StaticResource PageTitle}"/>
<Grid Grid.Row="1" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><Image x:Name="Avatar" Width="48" Height="48" Stretch="UniformToFill"/><StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center"><TextBlock x:Name="Nickname" Text="登录云音乐" FontSize="18" TextTrimming="CharacterEllipsis"/><TextBlock Text="把喜欢的音乐留在身边" FontSize="12" Foreground="{StaticResource SecondaryText}" Margin="0,5,0,0"/></StackPanel><Button x:Name="Account" Grid.Column="2" Click="AccountClick" Style="{StaticResource MetroButton}" AutomationProperties.Name="登录云音乐" ToolTipService.ToolTip="账户"><FontIcon Glyph="&#xE77B;" FontSize="20"/></Button></Grid>
<Grid Grid.Row="2" Margin="0,0,0,12"><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="48"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Grid.Row="0" Grid.Column="0" Click="LikesClick" Style="{StaticResource MetroButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="0,8"><StackPanel Orientation="Horizontal"><FontIcon Glyph="&#xEB51;" FontSize="20" Width="28"/><TextBlock Text="我喜欢的音乐" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel></Button><Button Grid.Row="0" Grid.Column="1" Click="DownloadsClick" Style="{StaticResource MetroButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="0,8"><StackPanel Orientation="Horizontal"><FontIcon Glyph="&#xE896;" FontSize="20" Width="28"/><TextBlock Text="离线音乐" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel></Button><Button Grid.Row="1" Grid.Column="0" Click="ArtistsClick" Style="{StaticResource MetroButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="0,8"><StackPanel Orientation="Horizontal"><FontIcon Glyph="&#xE77B;" FontSize="20" Width="28"/><TextBlock Text="收藏歌手" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel></Button><Button Grid.Row="1" Grid.Column="1" Click="AlbumsClick" Style="{StaticResource MetroButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="0,8"><StackPanel Orientation="Horizontal"><FontIcon Glyph="&#xE93C;" FontSize="20" Width="28"/><TextBlock Text="收藏专辑" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel></Button></Grid><Pivot Grid.Row="3" SelectedIndex="0"><PivotItem Header="歌单"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock x:Name="PlaylistStatus" Foreground="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/><ListView Grid.Row="1" x:Name="Playlists" ItemTemplate="{StaticResource MusicRowTemplate}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="PlaylistClick"/></Grid></PivotItem><PivotItem Header="最近"><ListView x:Name="Recent" ItemTemplate="{StaticResource MusicRowTemplate}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="TrackClick"/></PivotItem></Pivot></Grid></base:MusicPage>
