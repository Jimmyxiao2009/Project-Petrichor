<base:MusicPage x:Class="Petrichor.App.Pages.LyricsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:base="using:Petrichor.App">
<Grid Margin="20,20,20,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="48"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="Title" Text="歌词" FontSize="22" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="Status" Foreground="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,20"/></StackPanel><Button Grid.Column="1" Click="PlayerClick" Style="{StaticResource MetroButton}" VerticalAlignment="Top" AutomationProperties.Name="返回播放器" ToolTipService.ToolTip="返回播放器"><FontIcon Glyph="&#xE72B;" FontSize="20"/></Button><Button Grid.Column="2" Click="OptionsClick" Style="{StaticResource MetroButton}" VerticalAlignment="Top" AutomationProperties.Name="歌词显示选项" ToolTipService.ToolTip="显示选项"><FontIcon Glyph="&#xE713;" FontSize="20"/></Button></Grid>
<ListView Grid.Row="1" x:Name="Lines" SelectionMode="None" IsItemClickEnabled="True" ItemClick="LineClick" HorizontalAlignment="Stretch"><ListView.Header><Border Height="60"/></ListView.Header><ListView.Footer><Border Height="140"/></ListView.Footer><ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle><ListView.ItemTemplate><DataTemplate><StackPanel Margin="0,14,0,14"><TextBlock Text="{Binding Text}" Foreground="{Binding Foreground}" FontSize="{Binding FontSize}" FontWeight="{Binding Weight}" TextWrapping="Wrap" FontFamily="Segoe UI Light"/><TextBlock Text="{Binding Translation}" Foreground="{StaticResource SecondaryText}" FontSize="13" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView>
</Grid></base:MusicPage>


