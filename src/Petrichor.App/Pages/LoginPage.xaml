<base:MusicPage x:Class="Petrichor.App.Pages.LoginPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:base="using:Petrichor.App">
  <ScrollViewer>
    <StackPanel Margin="20,20,20,24">
      <StackPanel>
        <TextBlock x:Name="Title" Text="登录云音乐" Style="{StaticResource PageTitle}" />
      </StackPanel>
      <TextBlock Text="带上你收藏的每一个瞬间。" Foreground="{StaticResource SecondaryText}" Margin="0,0,0,28" />
      <Border Background="White" Padding="12" Width="240" Height="240" HorizontalAlignment="Center">
        <Image x:Name="QrImage" Stretch="Uniform" AutomationProperties.Name="网易云扫码登录二维码" />
      </Border>
      <TextBlock x:Name="Status" Text="正在生成二维码…" FontSize="18" TextWrapping="Wrap" TextAlignment="Center" Margin="0,22,0,8" />
      <TextBlock Text="使用手机上的网易云音乐扫码，&#xA;并在网易云音乐中确认登录。" TextAlignment="Center" FontSize="13" Foreground="{StaticResource SecondaryText}" LineHeight="22" />
      <Button Click="RefreshClick" Style="{StaticResource MetroButton}">
        <base:IconLabel Glyph="" Text="刷新二维码" />
      </Button>
    </StackPanel>
  </ScrollViewer>
</base:MusicPage>
