<base:MusicPage x:Class="Petrichor.App.Pages.CommentsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:base="using:Petrichor.App"><Grid Margin="20,20,20,8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock Text="评论" Style="{StaticResource PageTitle}"/><TextBlock Grid.Row="1" x:Name="SongTitle" Foreground="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" Margin="0,0,0,12"/>
<Pivot Grid.Row="2"><PivotItem Header="精彩"><ListView x:Name="Hot" SelectionMode="None" IsItemClickEnabled="True" ItemClick="CommentClick" ItemTemplate="{StaticResource CommentTemplate}"/></PivotItem><PivotItem Header="最新"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ListView x:Name="Latest" SelectionMode="None" IsItemClickEnabled="True" ItemClick="CommentClick" ItemTemplate="{StaticResource CommentTemplate}"/><Button Grid.Row="1" x:Name="More" Click="MoreClick" Style="{StaticResource MetroButton}" HorizontalAlignment="Stretch" AutomationProperties.Name="加载更多评论"><FontIcon Glyph="&#xE70D;" FontSize="20"/></Button></Grid></PivotItem></Pivot>
<Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><TextBlock x:Name="ReplyStatus" Foreground="{StaticResource SecondaryText}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><Button x:Name="CancelReply" Grid.Column="1" Click="CancelReplyClick" Style="{StaticResource MetroButton}" AutomationProperties.Name="取消回复" Visibility="Collapsed"><FontIcon Glyph="&#xE711;" FontSize="16"/></Button></Grid>
<Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><TextBox x:Name="Composer" PlaceholderText="写下你的感受…" MaxLength="1000" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="100" AutomationProperties.Name="评论内容"/><Button Grid.Column="1" x:Name="Send" Click="SendClick" Style="{StaticResource MetroButton}" AutomationProperties.Name="发送评论" ToolTipService.ToolTip="发送"><FontIcon Glyph="&#xE724;" FontSize="20"/></Button></Grid>
</Grid></base:MusicPage>

