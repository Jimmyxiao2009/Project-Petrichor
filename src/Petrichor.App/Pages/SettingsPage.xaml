<base:MusicPage x:Class="Petrichor.App.Pages.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:base="using:Petrichor.App">
  <ScrollViewer>
    <StackPanel Margin="20,20,20,24">
      <TextBlock Text="设置" Style="{StaticResource PageTitle}" />
      <TextBlock Text="播放音质" Style="{StaticResource SectionTitle}" />
      <ComboBox x:Name="Quality" HorizontalAlignment="Stretch" SelectionChanged="QualityChanged">
        <ComboBoxItem Content="标准 · 128 kbps" />
        <ComboBoxItem Content="较高 · 192 kbps" />
        <ComboBoxItem Content="极高 · 320 kbps" />
      </ComboBox>
      <TextBlock Text="部分歌曲需要会员，音质以实际播放为准。" TextWrapping="Wrap" Foreground="{StaticResource SecondaryText}" FontSize="11" Margin="0,8,0,0" />
      <TextBlock Text="播放方式" Style="{StaticResource SectionTitle}" />
      <ComboBox x:Name="Repeat" HorizontalAlignment="Stretch" SelectionChanged="RepeatChanged">
        <ComboBoxItem Content="顺序播放" />
        <ComboBoxItem Content="列表循环" />
        <ComboBoxItem Content="单曲循环" />
      </ComboBox>
      <ToggleSwitch x:Name="Shuffle" Header="随机播放" Toggled="ShuffleChanged" Margin="0,14,0,0" />
      <TextBlock Text="睡眠定时" Style="{StaticResource SectionTitle}" />
      <ComboBox x:Name="Sleep" HorizontalAlignment="Stretch" SelectionChanged="SleepChanged">
        <ComboBoxItem Content="关闭" />
        <ComboBoxItem Content="15 分钟后暂停" />
        <ComboBoxItem Content="30 分钟后暂停" />
        <ComboBoxItem Content="60 分钟后暂停" />
      </ComboBox>
      <TextBlock Text="歌词与图片缓存" Style="{StaticResource SectionTitle}" />
      <TextBlock x:Name="CacheStatus" Foreground="{StaticResource SecondaryText}" FontSize="12" />
      <Button Click="ClearCacheClick" Style="{StaticResource MetroButton}" HorizontalAlignment="Left">
        <base:IconLabel Glyph="" Text="清理缓存" />
      </Button>
      <TextBlock Text="已缓存的歌曲会保留。" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" FontSize="11" />
    </StackPanel>
  </ScrollViewer>
</base:MusicPage>
