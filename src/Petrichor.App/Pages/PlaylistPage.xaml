<base:MusicPage x:Class="Petrichor.App.Pages.PlaylistPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:base="using:Petrichor.App"><Grid Margin="20,20,20,8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="108"/><ColumnDefinition/></Grid.ColumnDefinitions><Image x:Name="Cover" Width="100" Height="100" Stretch="UniformToFill"/><StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock x:Name="Title" FontSize="22" TextWrapping="Wrap" MaxLines="3"/><TextBlock x:Name="Subtitle" Foreground="{StaticResource SecondaryText}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Grid>
<TextBlock Grid.Row="1" x:Name="Description" TextWrapping="Wrap" MaxLines="2" Foreground="{StaticResource SecondaryText}" FontSize="12" Margin="0,12,0,0"/>
<Grid Grid.Row="2" Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><Button Click="PlayAll" Style="{StaticResource AccentButton}" HorizontalAlignment="Stretch"><base:IconLabel Glyph="&#xE768;" Text="播放全部"/></Button><Button Grid.Column="1" Click="SelectClick" Style="{StaticResource MetroButton}" AutomationProperties.Name="多选歌曲" ToolTipService.ToolTip="多选"><FontIcon Glyph="&#xE762;" FontSize="20"/></Button></Grid>
<ListView Grid.Row="3" x:Name="Tracks" ItemTemplate="{StaticResource MusicRowTemplate}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="SongClick" SelectionChanged="SelectionChanged" Holding="SongHolding" RightTapped="SongRightTapped"/>
<Grid Grid.Row="4">
<Grid x:Name="SelectionBar" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock x:Name="SelectionCount" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
<Button Grid.Column="1" Click="PlaySelected" Style="{StaticResource MetroButton}" AutomationProperties.Name="播放所选"><FontIcon Glyph="&#xE768;" FontSize="18"/></Button><Button Grid.Column="2" Click="CacheSelected" Style="{StaticResource MetroButton}" AutomationProperties.Name="缓存所选"><FontIcon Glyph="&#xE896;" FontSize="18"/></Button><Button Grid.Column="3" Click="AddSelected" Style="{StaticResource MetroButton}" AutomationProperties.Name="收藏所选到歌单"><FontIcon Glyph="&#xE710;" FontSize="18"/></Button><Button Grid.Column="4" Click="AllSelected" Style="{StaticResource MetroButton}" AutomationProperties.Name="全选歌曲"><FontIcon Glyph="&#xE73A;" FontSize="18"/></Button><Button Grid.Column="5" Click="SelectClick" Style="{StaticResource MetroButton}" AutomationProperties.Name="退出多选"><FontIcon Glyph="&#xE711;" FontSize="18"/></Button></Grid></Grid>
</Grid></base:MusicPage>


