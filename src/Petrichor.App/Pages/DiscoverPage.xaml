<base:MusicPage x:Class="Petrichor.App.Pages.DiscoverPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:base="using:Petrichor.App">
  <ScrollViewer>
    <StackPanel Margin="20,20,20,20">
      <TextBlock Text="发现" Style="{StaticResource PageTitle}" />
      <Grid Margin="0,0,0,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition />
          <ColumnDefinition />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Button Click="DailyClick" Style="{StaticResource MetroButton}" HorizontalAlignment="Stretch" Padding="0,8">
          <StackPanel>
            <FontIcon Glyph="" FontSize="20" />
            <TextBlock Text="每日推荐" FontSize="11" Margin="0,8,0,0" />
          </StackPanel>
        </Button>
        <Button Grid.Column="1" Click="FmClick" Style="{StaticResource MetroButton}" HorizontalAlignment="Stretch" Padding="0,8">
          <StackPanel>
            <FontIcon Glyph="" FontSize="20" />
            <TextBlock Text="私人 FM" FontSize="11" Margin="0,8,0,0" />
          </StackPanel>
        </Button>
        <Button Grid.Column="2" Click="ChartsClick" Style="{StaticResource MetroButton}" HorizontalAlignment="Stretch" Padding="0,8">
          <StackPanel>
            <FontIcon Glyph="" FontSize="20" />
            <TextBlock Text="排行榜" FontSize="11" Margin="0,8,0,0" />
          </StackPanel>
        </Button>
        <Button Grid.Column="3" Click="ExploreClick" Style="{StaticResource MetroButton}" HorizontalAlignment="Stretch" Padding="0,8">
          <StackPanel>
            <FontIcon Glyph="" FontSize="20" />
            <TextBlock Text="歌单广场" FontSize="11" Margin="0,8,0,0" />
          </StackPanel>
        </Button>
      </Grid>
      <Grid>
        <TextBlock x:Name="Section" Text="为你发现" Style="{StaticResource SectionTitle}" />
        <Button Click="RefreshClick" AutomationProperties.Name="刷新推荐" ToolTipService.ToolTip="刷新" Style="{StaticResource MetroButton}" HorizontalAlignment="Right" VerticalAlignment="Bottom">
          <FontIcon Glyph="&#xE72C;" FontSize="20"/>
        </Button>
      </Grid>
      <TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="{StaticResource SecondaryText}" Margin="0,0,0,8" />
      <GridView x:Name="Recommendations" ItemTemplate="{StaticResource CoverTemplate}" ItemContainerStyle="{StaticResource CoverItemStyle}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="PlaylistClick" />
    </StackPanel>
  </ScrollViewer>
</base:MusicPage>

