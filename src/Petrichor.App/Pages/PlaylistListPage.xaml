<base:MusicPage x:Class="Petrichor.App.Pages.PlaylistListPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:base="using:Petrichor.App">
  <Grid Margin="20,20,20,8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock x:Name="Title" Text="歌单" Style="{StaticResource PageTitle}" />
    </StackPanel>
    <ComboBox Grid.Row="1" x:Name="Category" SelectedIndex="0" SelectionChanged="CategoryChanged" Margin="0,0,0,14" HorizontalAlignment="Stretch">
      <ComboBoxItem Content="全部" />
      <ComboBoxItem Content="华语" />
      <ComboBoxItem Content="轻音乐" />
      <ComboBoxItem Content="后摇" />
      <ComboBoxItem Content="夜晚" />
    </ComboBox>
    <GridView Grid.Row="2" x:Name="Items" ItemTemplate="{StaticResource CoverTemplate}" ItemContainerStyle="{StaticResource CoverItemStyle}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="PlaylistClick" />
    <Button Grid.Row="3" x:Name="More" Style="{StaticResource MetroButton}" Click="MoreClick">
      <base:IconLabel Glyph="" Text="加载更多" />
    </Button>
  </Grid>
</base:MusicPage>
