<base:MusicPage x:Class="Petrichor.App.Pages.PlayerPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:base="using:Petrichor.App">
<Grid Margin="20,20,20,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock x:Name="Title" Text="音乐，等你按下播放" FontSize="22" FontFamily="Segoe UI" TextTrimming="CharacterEllipsis"/><Button x:Name="Artist" Content="从搜索中选择一首歌曲" Click="ArtistClick" Style="{StaticResource MetroButton}" Padding="0,6" HorizontalAlignment="Left" MinHeight="32"/></StackPanel>
<Border Grid.Row="1" Background="{StaticResource Surface}" Margin="0,12,0,12"><Image x:Name="Cover" Source="ms-appx:///Assets/Forest.png" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/></Border>
<StackPanel Grid.Row="2"><Button x:Name="AlbumButton" Content="专辑" Click="AlbumClick" Style="{StaticResource MetroButton}" Padding="0,4" MinHeight="28" HorizontalAlignment="Left"/><Slider x:Name="Progress" Minimum="0" Maximum="1" ValueChanged="SeekChanged" AutomationProperties.Name="播放进度"/><Grid><TextBlock x:Name="Elapsed" Text="00:00" FontSize="11" Foreground="{StaticResource SecondaryText}"/><TextBlock x:Name="Duration" Text="00:00" FontSize="11" HorizontalAlignment="Right" Foreground="{StaticResource SecondaryText}"/></Grid><TextBlock x:Name="Status" Foreground="{StaticResource SecondaryText}" FontSize="11" TextAlignment="Center"/></StackPanel>
<Grid Grid.Row="3" Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Click="PreviousClick" Style="{StaticResource MetroButton}" HorizontalAlignment="Stretch" AutomationProperties.Name="上一首" ToolTipService.ToolTip="上一首"><FontIcon Glyph="&#xE892;" FontSize="24"/></Button><Button Grid.Column="1" x:Name="Play" Click="PlayClick" Style="{StaticResource MetroButton}" Foreground="{StaticResource Accent}" HorizontalAlignment="Stretch" AutomationProperties.Name="播放或暂停"><FontIcon x:Name="PlayGlyph" Glyph="&#xE768;" FontSize="30"/></Button><Button Grid.Column="2" Click="NextClick" Style="{StaticResource MetroButton}" HorizontalAlignment="Stretch" AutomationProperties.Name="下一首" ToolTipService.ToolTip="下一首"><FontIcon Glyph="&#xE893;" FontSize="24"/></Button></Grid>
<Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
<Button Click="LyricsClick" Style="{StaticResource MetroButton}" AutomationProperties.Name="歌词" ToolTipService.ToolTip="歌词"><FontIcon Glyph="&#xE8D2;" FontSize="20"/></Button>
<Button Grid.Column="1" x:Name="Like" Click="LikeClick" Style="{StaticResource MetroButton}" AutomationProperties.Name="喜欢" ToolTipService.ToolTip="喜欢"><FontIcon x:Name="LikeGlyph" Glyph="&#xEB51;" FontSize="20"/></Button>
<Button Grid.Column="2" Click="AddPlaylistClick" Style="{StaticResource MetroButton}" AutomationProperties.Name="收藏到歌单" ToolTipService.ToolTip="收藏到歌单"><FontIcon Glyph="&#xE710;" FontSize="20"/></Button>
<Button Grid.Column="3" Click="CommentsClick" Style="{StaticResource MetroButton}" AutomationProperties.Name="评论" ToolTipService.ToolTip="评论"><FontIcon Glyph="&#xE90A;" FontSize="20"/></Button>
<Button Grid.Column="4" x:Name="Download" Click="DownloadClick" Style="{StaticResource MetroButton}" AutomationProperties.Name="下载" ToolTipService.ToolTip="下载"><FontIcon Glyph="&#xE896;" FontSize="20"/></Button>
<Button Grid.Column="5" Click="QueueClick" Style="{StaticResource MetroButton}" AutomationProperties.Name="队列" ToolTipService.ToolTip="队列"><FontIcon Glyph="&#xE8FD;" FontSize="20"/></Button></Grid>
</Grid></base:MusicPage>


