<base:MusicPage x:Class="Petrichor.App.Pages.DownloadsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:base="using:Petrichor.App"><Grid Margin="20,20,20,8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
<Grid><TextBlock Text="下载" Style="{StaticResource PageTitle}"/><Button HorizontalAlignment="Right" Click="RefreshClick" Style="{StaticResource MetroButton}" AutomationProperties.Name="刷新下载" ToolTipService.ToolTip="刷新"><FontIcon Glyph="&#xE72C;" FontSize="20"/></Button></Grid>
<Pivot Grid.Row="1"><PivotItem Header="离线音乐"><Grid><ListView x:Name="Saved" ItemTemplate="{StaticResource MusicRowTemplate}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="SavedClick" HorizontalAlignment="Stretch"/><TextBlock x:Name="SavedEmpty" Text="下载喜欢的音乐，离线也能听。" TextWrapping="Wrap" Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></PivotItem>
<PivotItem Header="下载中"><Grid><ListView x:Name="Pending" SelectionMode="None" IsItemClickEnabled="True" ItemClick="DownloadClick" HorizontalContentAlignment="Stretch"><ListView.ItemTemplate><DataTemplate><StackPanel Padding="0,16" HorizontalAlignment="Stretch"><TextBlock Text="{Binding Title}" FontSize="16" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Artist}" Foreground="{StaticResource SecondaryText}" FontSize="11" Margin="0,5,0,0"/><ProgressBar Value="{Binding Percent}" Maximum="100" Margin="0,14,0,8"/><TextBlock Text="{Binding Status}" Foreground="{StaticResource SecondaryText}" FontSize="12"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView><TextBlock x:Name="PendingEmpty" Text="没有正在下载的歌曲" Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></PivotItem></Pivot>
</Grid></base:MusicPage>

