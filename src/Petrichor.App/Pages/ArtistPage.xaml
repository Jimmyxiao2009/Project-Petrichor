<base:MusicPage x:Class="Petrichor.App.Pages.ArtistPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:base="using:Petrichor.App">
  <Grid Margin="20,20,20,8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition />
    </Grid.RowDefinitions>
    <Grid Grid.Row="1" Margin="0,12,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="108" />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <Image x:Name="Cover" Width="100" Height="100" Stretch="UniformToFill" />
      <StackPanel Grid.Column="1" Margin="12,0,0,0">
        <TextBlock x:Name="Title" FontSize="22" TextWrapping="Wrap" MaxLines="3" />
        <TextBlock x:Name="Subtitle" Foreground="{StaticResource SecondaryText}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
      </StackPanel>
    </Grid>
    <StackPanel Grid.Row="2">
      <TextBlock x:Name="Description" TextWrapping="Wrap" MaxLines="3" Foreground="{StaticResource SecondaryText}" FontSize="12" />
      <StackPanel Orientation="Horizontal" Margin="0,12,0,8">
        <Button Click="PlayAll" Style="{StaticResource AccentButton}">
          <base:IconLabel Glyph="" Text="热门歌曲" />
        </Button>
        <Button Click="SaveClick" Style="{StaticResource MetroButton}">
          <base:IconLabel Glyph="" Text="收藏歌手" />
        </Button>
      </StackPanel>
    </StackPanel>
    <Grid Grid.Row="3">
      <Pivot>
        <PivotItem Header="热门">
          <ListView x:Name="Tracks" ItemTemplate="{StaticResource MusicRowTemplate}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="TrackClick" />
        </PivotItem>
        <PivotItem Header="专辑">
          <ListView x:Name="Albums" ItemTemplate="{StaticResource MusicRowTemplate}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="AlbumClick" />
        </PivotItem>
        <PivotItem Header="简介">
          <ScrollViewer>
            <TextBlock x:Name="Biography" TextWrapping="Wrap" FontSize="14" LineHeight="25" Foreground="{StaticResource SecondaryText}" />
          </ScrollViewer>
        </PivotItem>
      </Pivot>
    </Grid>
  </Grid>
</base:MusicPage>
