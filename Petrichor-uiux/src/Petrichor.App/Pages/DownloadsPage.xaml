<base:MusicPage x:Class="Petrichor.App.Pages.DownloadsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:base="using:Petrichor.App"><Grid Margin="12,8,12,8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
<Grid><TextBlock Text="下载" Style="{StaticResource PageTitle}" Margin="0" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,-14,0"><Button x:Name="SelectButton" Click="SelectClick" Style="{StaticResource IconButton}" AutomationProperties.Name="多选已下载歌曲" ToolTipService.ToolTip="多选"><FontIcon Glyph="&#xE762;" FontSize="18"/></Button><Button Click="RefreshClick" Style="{StaticResource IconButton}" AutomationProperties.Name="刷新下载" ToolTipService.ToolTip="刷新"><FontIcon Glyph="&#xE72C;" FontSize="18"/></Button></StackPanel></Grid>
<Pivot Grid.Row="1" Style="{StaticResource SubPivot}"><PivotItem Header="离线音乐"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ListView x:Name="Saved" ItemTemplate="{StaticResource MusicRowTemplate}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="SavedClick" SelectionChanged="SavedSelectionChanged" Holding="SavedHolding" RightTapped="SavedRightTapped" PointerPressed="SavedPointerPressed" HorizontalAlignment="Stretch"/><TextBlock x:Name="SavedEmpty" Text="下载喜欢的音乐，离线也能听。" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource SecondaryText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
<Grid Grid.Row="1" x:Name="SelectionBar" Visibility="Collapsed" BorderBrush="{ThemeResource Divider}" BorderThickness="0,1,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="SelectionCount" VerticalAlignment="Center" FontSize="12"/><Button Grid.Column="1" Click="DeleteSelected" Style="{StaticResource IconButton}" AutomationProperties.Name="删除所选" ToolTipService.ToolTip="删除所选"><FontIcon Glyph="&#xE74D;" FontSize="18"/></Button><Button Grid.Column="2" Click="AllSelected" Style="{StaticResource IconButton}" AutomationProperties.Name="全选已下载歌曲" ToolTipService.ToolTip="全选"><FontIcon Glyph="&#xE73A;" FontSize="18"/></Button><Button Grid.Column="3" Click="SelectClick" Style="{StaticResource IconButton}" AutomationProperties.Name="退出多选" ToolTipService.ToolTip="退出多选"><FontIcon Glyph="&#xE711;" FontSize="18"/></Button></Grid></Grid></PivotItem>
<PivotItem Header="下载中"><Grid><ListView x:Name="Pending" SelectionMode="None" IsItemClickEnabled="True" ItemClick="DownloadClick" Holding="PendingHolding" RightTapped="PendingRightTapped" PointerPressed="PendingPointerPressed" HorizontalContentAlignment="Stretch"><ListView.ItemTemplate><DataTemplate><StackPanel Padding="0,12" HorizontalAlignment="Stretch"><TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Artist}" Foreground="{ThemeResource SecondaryText}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/><ProgressBar Value="{Binding Percent}" Maximum="100" Margin="0,10,0,6"/><TextBlock Text="{Binding Status}" Foreground="{ThemeResource SecondaryText}" FontSize="12"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView><TextBlock x:Name="PendingEmpty" Text="没有正在下载的歌曲" TextAlignment="Center" Foreground="{ThemeResource SecondaryText}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></PivotItem></Pivot>
</Grid></base:MusicPage>
