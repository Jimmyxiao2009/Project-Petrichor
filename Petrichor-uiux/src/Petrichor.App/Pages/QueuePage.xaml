<base:MusicPage x:Class="Petrichor.App.Pages.QueuePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:base="using:Petrichor.App">
  <Grid Margin="12,8,12,8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="播放队列" Style="{StaticResource PageTitle}" />
    </StackPanel>
    <TextBlock Grid.Row="1" x:Name="Status" Foreground="{ThemeResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,12" />
    <ListView Grid.Row="2" x:Name="Tracks" ItemTemplate="{StaticResource MusicRowTemplate}" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="TrackClick" />
  </Grid>
</base:MusicPage>

