<base:MusicPage x:Class="Petrichor.App.Pages.PodcastPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:base="using:Petrichor.App">
 <Grid Margin="12,8,12,0">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Width="100" Height="100" Background="{ThemeResource SurfaceAlt}" CornerRadius="2"><Image x:Name="Cover" Stretch="UniformToFill"/></Border>
   <StackPanel Grid.Column="1" Margin="12,0,0,0">
    <TextBlock x:Name="Title" FontSize="20" FontFamily="Segoe UI Semilight" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"/>
    <TextBlock x:Name="Host" Foreground="{ThemeResource SecondaryText}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
    <TextBlock x:Name="Stats" Foreground="{ThemeResource SecondaryText}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
   </StackPanel>
  </Grid>
  <TextBlock Grid.Row="1" x:Name="Description" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource SecondaryText}" FontSize="12" LineHeight="18" Margin="0,12,0,0"/>
  <StackPanel Grid.Row="2" x:Name="Actions" Orientation="Horizontal" Margin="0,12,0,0">
   <Button Click="PlayAllClick" Style="{StaticResource AccentButton}" Margin="0,0,8,0"><base:IconLabel Glyph="&#xE768;" Text="播放全部"/></Button>
   <Button x:Name="Subscribe" Click="SubscribeClick" Style="{StaticResource MetroButton}"><base:IconLabel x:Name="SubscribeLabel" Glyph="&#xE734;" Text="订阅"/></Button>
  </StackPanel>
  <Grid Grid.Row="3" Margin="0,8,0,0" BorderBrush="{ThemeResource Divider}" BorderThickness="0,0,0,1">
   <TextBlock x:Name="EpisodeCount" FontSize="14" VerticalAlignment="Center"/>
   <Button x:Name="Order" Click="OrderClick" Style="{StaticResource MetroButton}" HorizontalAlignment="Right" Margin="0,0,-12,0" AutomationProperties.Name="切换排序">
    <base:IconLabel x:Name="OrderLabel" Glyph="&#xE8CB;" Text="最新在前"/>
   </Button>
  </Grid>
  <TextBox Grid.Row="4" x:Name="EpisodeSearch" Height="36" Padding="8,7,6,0" PlaceholderText="搜索节目" Margin="0,8,0,0" TextChanged="EpisodeSearchChanged"/>
  <Grid Grid.Row="5">
   <ListView x:Name="Episodes" ItemTemplate="{StaticResource EpisodeRowTemplate}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="EpisodeClick">
    <ListView.Footer><Button x:Name="More" Click="MoreClick" Style="{StaticResource FooterButton}" Visibility="Collapsed"><base:IconLabel Glyph="&#xE70D;" Text="加载更多"/></Button></ListView.Footer>
   </ListView>
   <StackPanel x:Name="Empty" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" Margin="24,0">
    <FontIcon Glyph="&#xE720;" FontSize="40" Foreground="{ThemeResource SecondaryText}"/>
    <TextBlock x:Name="EmptyText" Text="播客即将上线" FontSize="14" TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource SecondaryText}" Margin="0,12,0,0"/>
   </StackPanel>
  </Grid>
 </Grid>
</base:MusicPage>
