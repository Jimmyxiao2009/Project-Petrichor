<base:MusicPage x:Class="Petrichor.App.Pages.LoginPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:base="using:Petrichor.App">
  <ScrollViewer>
    <StackPanel Margin="12,8,12,24">
      <TextBlock x:Name="Title" Text="登录云音乐" Style="{StaticResource PageTitle}" Margin="0,0,0,4" />
      <TextBlock Text="带上你收藏的每一个瞬间。" Foreground="{ThemeResource SecondaryText}" FontSize="14" Margin="0,0,0,24" />
      <Border Background="{ThemeResource Surface}" BorderBrush="{ThemeResource Divider}" BorderThickness="1" Padding="16" HorizontalAlignment="Center"><Border Background="White" Padding="12" Width="208" Height="208">
        <Image x:Name="QrImage" Stretch="Uniform" AutomationProperties.Name="网易云扫码登录二维码" />
      </Border></Border>
      <TextBlock x:Name="Status" Text="正在生成二维码…" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" Margin="0,20,0,8" />
      <TextBlock Text="使用手机上的网易云音乐扫码，&#xA;并在网易云音乐中确认登录。" TextAlignment="Center" FontSize="12" Foreground="{ThemeResource SecondaryText}" LineHeight="20" />
      <Button Click="RefreshClick" Style="{StaticResource MetroButton}" HorizontalAlignment="Center" Margin="0,12,0,0">
        <base:IconLabel Glyph="&#xE72C;" Text="刷新二维码" />
      </Button>
    </StackPanel>
  </ScrollViewer>
</base:MusicPage>
