<base:MusicPage x:Class="Petrichor.App.Pages.LyricsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:base="using:Petrichor.App">
<Grid Margin="12,8,12,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Title" Text="歌词" Style="{StaticResource PageTitle}" Margin="0,0,8,0" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><Button Grid.Column="1" Click="PlayerClick" Style="{StaticResource IconButton}" AutomationProperties.Name="返回播放器" ToolTipService.ToolTip="返回播放器"><FontIcon Glyph="&#xE72B;" FontSize="18"/></Button><Button Grid.Column="2" Click="OptionsClick" Style="{StaticResource IconButton}" Margin="0,0,-14,0" AutomationProperties.Name="歌词显示选项" ToolTipService.ToolTip="显示选项"><FontIcon Glyph="&#xE713;" FontSize="18"/></Button></Grid>
<TextBlock Grid.Row="1" x:Name="Status" Foreground="{ThemeResource SecondaryText}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
<ListView Grid.Row="2" x:Name="Lines" SelectionMode="None" IsItemClickEnabled="True" ItemClick="LineClick" HorizontalAlignment="Stretch"><ListView.Header><Border Height="60"/></ListView.Header><ListView.Footer><Border Height="140"/></ListView.Footer><ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle><ListView.ItemTemplate><DataTemplate><StackPanel Margin="0,14,0,14"><TextBlock Text="{Binding Text}" Foreground="{Binding Foreground}" FontSize="{Binding FontSize}" FontWeight="{Binding Weight}" TextWrapping="Wrap" FontFamily="Segoe UI Light"/><TextBlock Text="{Binding Translation}" Foreground="{ThemeResource SecondaryText}" FontSize="13" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView>
</Grid></base:MusicPage>
