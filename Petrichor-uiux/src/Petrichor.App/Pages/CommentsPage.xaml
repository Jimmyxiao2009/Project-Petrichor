<base:MusicPage x:Class="Petrichor.App.Pages.CommentsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:base="using:Petrichor.App" NavigationCacheMode="Enabled">
<base:MusicPage.Resources>
 <Style x:Key="EmptyText" TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource SecondaryText}"/><Setter Property="FontSize" Value="14"/><Setter Property="TextAlignment" Value="Center"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="24,0"/><Setter Property="Visibility" Value="Collapsed"/></Style>
</base:MusicPage.Resources>
<Grid Margin="12,8,12,8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid><TextBlock Text="评论" Style="{StaticResource PageTitle}" Margin="0" VerticalAlignment="Center"/><TextBlock x:Name="Total" FontSize="12" Foreground="{ThemeResource SecondaryText}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
<TextBlock Grid.Row="1" x:Name="SongTitle" Foreground="{ThemeResource SecondaryText}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,4"/>
<Pivot Grid.Row="2" x:Name="Sorts" Style="{StaticResource SubPivot}" SelectionChanged="SortChanged">
 <PivotItem Header="推荐"><Grid>
  <ListView x:Name="RecommendedList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="CommentClick" ItemTemplate="{StaticResource CommentTemplate}"><ListView.Footer><Button x:Name="RecommendedMore" Click="MoreClick" Style="{StaticResource FooterButton}" Visibility="Collapsed"><base:IconLabel Glyph="&#xE70D;" Text="加载更多"/></Button></ListView.Footer></ListView>
  <TextBlock x:Name="RecommendedEmpty" Style="{StaticResource EmptyText}"/>
 </Grid></PivotItem>
 <PivotItem Header="最热"><Grid>
  <ListView x:Name="HotList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="CommentClick" ItemTemplate="{StaticResource CommentTemplate}"><ListView.Footer><Button x:Name="HotMore" Click="MoreClick" Style="{StaticResource FooterButton}" Visibility="Collapsed"><base:IconLabel Glyph="&#xE70D;" Text="加载更多"/></Button></ListView.Footer></ListView>
  <TextBlock x:Name="HotEmpty" Style="{StaticResource EmptyText}"/>
 </Grid></PivotItem>
 <PivotItem Header="最新"><Grid>
  <ListView x:Name="LatestList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="CommentClick" ItemTemplate="{StaticResource CommentTemplate}"><ListView.Footer><Button x:Name="LatestMore" Click="MoreClick" Style="{StaticResource FooterButton}" Visibility="Collapsed"><base:IconLabel Glyph="&#xE70D;" Text="加载更多"/></Button></ListView.Footer></ListView>
  <TextBlock x:Name="LatestEmpty" Style="{StaticResource EmptyText}"/>
 </Grid></PivotItem>
</Pivot>
<Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ReplyStatus" Foreground="{ThemeResource SecondaryText}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><Button x:Name="CancelReply" Grid.Column="1" Click="CancelReplyClick" Style="{StaticResource IconButton}" Width="40" Height="40" Margin="0,0,-4,0" AutomationProperties.Name="取消回复" ToolTipService.ToolTip="取消回复" Visibility="Collapsed"><FontIcon Glyph="&#xE711;" FontSize="14"/></Button></Grid>
<Grid Grid.Row="4" Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="Composer" MinHeight="40" Padding="10,9,6,6" PlaceholderText="写下你的感受…" MaxLength="1000" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="100" VerticalAlignment="Bottom" AutomationProperties.Name="评论内容"/><Button Grid.Column="1" x:Name="Send" Click="SendClick" Style="{StaticResource IconButton}" Margin="4,0,-4,0" VerticalAlignment="Bottom" AutomationProperties.Name="发送评论" ToolTipService.ToolTip="发送"><FontIcon Glyph="&#xE724;" FontSize="20"/></Button></Grid>
</Grid></base:MusicPage>
