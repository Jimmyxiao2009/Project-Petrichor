<base:MusicPage x:Class="Petrichor.App.Pages.DiscoverPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:base="using:Petrichor.App">
  <ScrollViewer>
    <StackPanel Margin="0,8,0,20">
      <Grid Margin="-6,0,-6,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition />
          <ColumnDefinition />
          <ColumnDefinition />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Button Click="DailyClick" Style="{StaticResource MetroButton}" HorizontalAlignment="Stretch" Padding="0,10">
          <StackPanel HorizontalAlignment="Center">
            <FontIcon Glyph="&#xE787;" FontSize="20" />
            <TextBlock Text="每日推荐" FontSize="12" Margin="0,8,0,0" HorizontalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Grid.Column="1" Click="FmClick" Style="{StaticResource MetroButton}" HorizontalAlignment="Stretch" Padding="0,10">
          <StackPanel HorizontalAlignment="Center">
            <FontIcon Glyph="&#xE93C;" FontSize="20" />
            <TextBlock Text="私人 FM" FontSize="12" Margin="0,8,0,0" HorizontalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Grid.Column="2" Click="ChartsClick" Style="{StaticResource MetroButton}" HorizontalAlignment="Stretch" Padding="0,10">
          <StackPanel HorizontalAlignment="Center">
            <FontIcon Glyph="&#xE9D9;" FontSize="20" />
            <TextBlock Text="排行榜" FontSize="12" Margin="0,8,0,0" HorizontalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Grid.Column="3" Click="ExploreClick" Style="{StaticResource MetroButton}" HorizontalAlignment="Stretch" Padding="0,10">
          <StackPanel HorizontalAlignment="Center">
            <FontIcon Glyph="&#xE8FD;" FontSize="20" />
            <TextBlock Text="歌单广场" FontSize="12" Margin="0,8,0,0" HorizontalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Grid.Column="4" Click="PodcastsClick" Style="{StaticResource MetroButton}" HorizontalAlignment="Stretch" Padding="0,10">
          <StackPanel HorizontalAlignment="Center">
            <FontIcon Glyph="&#xE720;" FontSize="20" />
            <TextBlock Text="播客" FontSize="12" Margin="0,8,0,0" HorizontalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
      <Grid Margin="0,8,0,8">
        <TextBlock x:Name="Section" Text="为你发现" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
        <Button Click="RefreshClick" AutomationProperties.Name="刷新推荐" ToolTipService.ToolTip="刷新" Style="{StaticResource IconButton}" HorizontalAlignment="Right" Margin="0,0,-14,0">
          <FontIcon Glyph="&#xE72C;" FontSize="18"/>
        </Button>
      </Grid>
      <TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="{ThemeResource SecondaryText}" FontSize="12" Margin="0,0,0,8" Visibility="Collapsed" />
      <GridView x:Name="Recommendations" Margin="0,0,-12,0" ItemTemplate="{StaticResource CoverTemplate}" ItemContainerStyle="{StaticResource CoverItemStyle}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="PlaylistClick" />
    </StackPanel>
  </ScrollViewer>
</base:MusicPage>
