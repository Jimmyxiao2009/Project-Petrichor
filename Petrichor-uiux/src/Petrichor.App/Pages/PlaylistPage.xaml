<base:MusicPage x:Class="Petrichor.App.Pages.PlaylistPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:base="using:Petrichor.App"><Grid Margin="12,8,12,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="100" Height="100" Background="{ThemeResource SurfaceAlt}" CornerRadius="2"><Image x:Name="Cover" Stretch="UniformToFill"/></Border><StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock x:Name="Title" FontSize="20" FontFamily="Segoe UI Semilight" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="Subtitle" Foreground="{ThemeResource SecondaryText}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel><Button x:Name="More" Grid.Column="2" Style="{StaticResource IconButton}" VerticalAlignment="Top" Margin="0,-8,-14,0" AutomationProperties.Name="歌单操作" ToolTipService.ToolTip="更多"><FontIcon Glyph="&#xE712;" FontSize="18"/><Button.Flyout><MenuFlyout><MenuFlyoutItem x:Name="DeletePlaylist" Text="删除歌单" Click="DeletePlaylistClick"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;"/></MenuFlyoutItem.Icon></MenuFlyoutItem></MenuFlyout></Button.Flyout></Button></Grid>
<TextBlock Grid.Row="1" x:Name="Description" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource SecondaryText}" FontSize="12" Margin="0,12,0,0"/>
<Grid Grid.Row="2" Margin="0,12,0,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Click="PlayAll" Style="{StaticResource AccentButton}" HorizontalAlignment="Stretch" VerticalAlignment="Center"><base:IconLabel Glyph="&#xE768;" Text="播放全部"/></Button><Button Grid.Column="1" Click="SelectClick" Style="{StaticResource IconButton}" Margin="8,0,-14,0" AutomationProperties.Name="多选歌曲" ToolTipService.ToolTip="多选"><FontIcon Glyph="&#xE762;" FontSize="20"/></Button></Grid>
<ListView Grid.Row="3" x:Name="Tracks" ItemTemplate="{StaticResource MusicRowTemplate}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="SongClick" SelectionChanged="SelectionChanged" Holding="SongHolding" RightTapped="SongRightTapped" PointerPressed="SongPointerPressed"/>
<Grid Grid.Row="4">
<Grid x:Name="SelectionBar" Visibility="Collapsed" BorderBrush="{ThemeResource Divider}" BorderThickness="0,1,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock x:Name="SelectionCount" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
<Button Grid.Column="1" Click="PlaySelected" Style="{StaticResource IconButton}" AutomationProperties.Name="播放所选" ToolTipService.ToolTip="播放所选"><FontIcon Glyph="&#xE768;" FontSize="18"/></Button><Button Grid.Column="2" Click="CacheSelected" Style="{StaticResource IconButton}" AutomationProperties.Name="缓存所选" ToolTipService.ToolTip="缓存所选"><FontIcon Glyph="&#xE896;" FontSize="18"/></Button><Button Grid.Column="3" Click="AddSelected" Style="{StaticResource IconButton}" AutomationProperties.Name="收藏所选到歌单" ToolTipService.ToolTip="收藏到歌单"><FontIcon Glyph="&#xE710;" FontSize="18"/></Button><Button Grid.Column="4" Click="AllSelected" Style="{StaticResource IconButton}" AutomationProperties.Name="全选歌曲" ToolTipService.ToolTip="全选"><FontIcon Glyph="&#xE73A;" FontSize="18"/></Button><Button Grid.Column="5" Click="SelectClick" Style="{StaticResource IconButton}" AutomationProperties.Name="退出多选" ToolTipService.ToolTip="退出多选"><FontIcon Glyph="&#xE711;" FontSize="18"/></Button></Grid></Grid>
</Grid></base:MusicPage>
