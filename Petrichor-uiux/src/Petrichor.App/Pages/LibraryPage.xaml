<base:MusicPage x:Class="Petrichor.App.Pages.LibraryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:base="using:Petrichor.App">
<base:MusicPage.Resources>
 <Style x:Key="QuickLink" TargetType="Button" BasedOn="{StaticResource MetroButton}"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="VerticalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="0"/></Style>
</base:MusicPage.Resources>
<Grid Margin="0,8,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
<Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <Border Width="48" Height="48" Background="{ThemeResource SurfaceAlt}" CornerRadius="2"><Image x:Name="Avatar" Stretch="UniformToFill"/></Border>
 <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center"><TextBlock x:Name="Nickname" Text="登录云音乐" FontSize="18" FontFamily="Segoe UI Semilight" TextTrimming="CharacterEllipsis"/><TextBlock Text="把喜欢的音乐留在身边" FontSize="12" Foreground="{ThemeResource SecondaryText}" Margin="0,2,0,0"/></StackPanel>
 <Button x:Name="Account" Grid.Column="2" Click="AccountClick" Style="{StaticResource IconButton}" AutomationProperties.Name="登录云音乐" ToolTipService.ToolTip="账户"><FontIcon Glyph="&#xE77B;" FontSize="20"/></Button>
 <Button Grid.Column="3" Click="SettingsClick" Style="{StaticResource IconButton}" Margin="0,0,-14,0" AutomationProperties.Name="设置" ToolTipService.ToolTip="设置"><FontIcon Glyph="&#xE713;" FontSize="20"/></Button>
</Grid>
<Grid Grid.Row="1" Margin="0,0,0,4"><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="48"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
 <Button Click="LikesClick" Style="{StaticResource QuickLink}"><StackPanel Orientation="Horizontal"><FontIcon Glyph="&#xEB51;" FontSize="20" Width="24"/><TextBlock Text="我喜欢的音乐" FontSize="14" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel></Button>
 <Button Grid.Column="1" Click="DownloadsClick" Style="{StaticResource QuickLink}"><StackPanel Orientation="Horizontal"><FontIcon Glyph="&#xE896;" FontSize="20" Width="24"/><TextBlock Text="离线音乐" FontSize="14" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel></Button>
 <Button Grid.Row="1" Click="ArtistsClick" Style="{StaticResource QuickLink}"><StackPanel Orientation="Horizontal"><FontIcon Glyph="&#xE77B;" FontSize="20" Width="24"/><TextBlock Text="收藏歌手" FontSize="14" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel></Button>
 <Button Grid.Row="1" Grid.Column="1" Click="AlbumsClick" Style="{StaticResource QuickLink}"><StackPanel Orientation="Horizontal"><FontIcon Glyph="&#xE93C;" FontSize="20" Width="24"/><TextBlock Text="收藏专辑" FontSize="14" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel></Button>
</Grid>
<Pivot Grid.Row="2" Style="{StaticResource SubPivot}" SelectedIndex="0"><PivotItem Header="歌单"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="PlaylistStatus" Foreground="{ThemeResource SecondaryText}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/><Button Grid.Column="1" Click="CreatePlaylistClick" Style="{StaticResource MetroButton}" AutomationProperties.Name="新建歌单" ToolTipService.ToolTip="新建歌单"><base:IconLabel Glyph="&#xE710;" Text="新建"/></Button></Grid><ListView Grid.Row="1" x:Name="Playlists" ItemTemplate="{StaticResource MusicRowTemplate}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="PlaylistClick"/></Grid></PivotItem><PivotItem Header="最近"><ListView x:Name="Recent" ItemTemplate="{StaticResource MusicRowTemplate}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="TrackClick"/></PivotItem></Pivot>
</Grid></base:MusicPage>
