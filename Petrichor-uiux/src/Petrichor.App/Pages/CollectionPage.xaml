<base:MusicPage x:Class="Petrichor.App.Pages.CollectionPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:base="using:Petrichor.App">
  <Grid Margin="12,8,12,8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock x:Name="Title" Style="{StaticResource PageTitle}" Margin="0,0,0,4" />
    <TextBlock Grid.Row="1" x:Name="Status" Foreground="{ThemeResource SecondaryText}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
    <ListView Grid.Row="2" x:Name="Items" ItemTemplate="{StaticResource MusicRowTemplate}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="ResultClick" />
    <Button Grid.Row="3" x:Name="More" Click="MoreClick" Style="{StaticResource FooterButton}">
      <base:IconLabel Glyph="&#xE70D;" Text="加载更多" />
    </Button>
  </Grid>
</base:MusicPage>
