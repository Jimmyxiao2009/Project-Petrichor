<base:MusicPage x:Class="Petrichor.App.Pages.AlbumPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:base="using:Petrichor.App">
  <Grid Margin="12,8,12,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition />
    </Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <Border Width="100" Height="100" Background="{ThemeResource SurfaceAlt}" CornerRadius="2">
        <Image x:Name="Cover" Stretch="UniformToFill" />
      </Border>
      <StackPanel Grid.Column="1" Margin="12,0,0,0">
        <TextBlock x:Name="Title" FontSize="20" FontFamily="Segoe UI Semilight" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="Subtitle" Foreground="{ThemeResource SecondaryText}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
      </StackPanel>
    </Grid>
    <StackPanel Grid.Row="1">
      <TextBlock x:Name="Description" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource SecondaryText}" FontSize="12" Margin="0,12,0,0" />
      <StackPanel Orientation="Horizontal" Margin="0,12,0,4">
        <Button Click="PlayAll" Style="{StaticResource AccentButton}" Margin="0,0,8,0">
          <base:IconLabel Glyph="&#xE768;" Text="播放全部" />
        </Button>
        <Button Click="ArtistClick" Style="{StaticResource MetroButton}">
          <base:IconLabel Glyph="&#xE77B;" Text="歌手" />
        </Button>
        <Button Click="SaveClick" Style="{StaticResource MetroButton}">
          <base:IconLabel Glyph="&#xE734;" Text="收藏" />
        </Button>
      </StackPanel>
    </StackPanel>
    <ListView Grid.Row="2" x:Name="Tracks" ItemTemplate="{StaticResource MusicRowTemplate}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="TrackClick" />
  </Grid>
</base:MusicPage>
