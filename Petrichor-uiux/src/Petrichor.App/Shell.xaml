<Page x:Class="Petrichor.App.Shell" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{ThemeResource PageBackground}">
 <Grid>
  <Grid.RowDefinitions>
   <RowDefinition Height="*" />
   <RowDefinition Height="Auto" />
   <RowDefinition x:Name="MiniPlayerRow" Height="58" />
  </Grid.RowDefinitions>
  <ProgressBar x:Name="Busy" Height="3" VerticalAlignment="Top" IsIndeterminate="True" Visibility="Collapsed" Canvas.ZIndex="5" Foreground="{StaticResource Accent}"/>
  <Grid>
   <!-- 顶层导航：Pivot，横滑切换 发现 / 搜索 / 我的 -->
   <Pivot x:Name="RootPivot" SelectionChanged="OnPivotChanged">
    <PivotItem Header="发现"><Frame x:Name="DiscoverFrame" /></PivotItem>
    <PivotItem Header="搜索"><Frame x:Name="SearchFrame" /></PivotItem>
    <PivotItem Header="我的"><Frame x:Name="LibraryFrame" /></PivotItem>
   </Pivot>
   <!-- 详情页覆盖层：歌单、专辑、播放器、设置等 -->
   <Frame x:Name="ContentFrame" HorizontalAlignment="Stretch" Navigated="OnNavigated" Visibility="Collapsed" Background="{ThemeResource PageBackground}" />
  </Grid>
  <Border x:Name="Notice" Grid.Row="1" Background="{ThemeResource SurfaceAlt}" BorderBrush="{StaticResource PetrichorAccent}" BorderThickness="3,0,0,0" Visibility="Collapsed" Padding="12,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="NoticeText" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" /><Button Grid.Column="1" Click="DismissNotice" Style="{StaticResource IconButton}" Width="40" Height="40" Margin="4,0,-8,0" AutomationProperties.Name="关闭提示"><FontIcon Glyph="&#xE711;" FontSize="14"/></Button></Grid></Border>
  <Border x:Name="MiniPlayer" Grid.Row="2" Background="{ThemeResource Surface}" BorderBrush="{ThemeResource Divider}" BorderThickness="0,1,0,0">
   <Grid>
    <ProgressBar x:Name="MiniProgress" Minimum="0" Maximum="1" Height="2" VerticalAlignment="Top" Foreground="{StaticResource PetrichorAccent}" Background="Transparent"/>
    <Grid Margin="0,2,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
     <Button x:Name="MiniOpen" Click="OpenPlayer" Padding="12,6,8,6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" Style="{StaticResource MetroButton}" AutomationProperties.Name="打开正在播放"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Image x:Name="MiniCover" Source="Assets/Forest.png" Width="40" Height="40" HorizontalAlignment="Left" Stretch="UniformToFill" /><StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="MiniTitle" Text="让音乐陪你走一段路" FontSize="13" TextTrimming="CharacterEllipsis" /><TextBlock x:Name="MiniArtist" Text="选择一首歌，开始播放" FontSize="12" Foreground="{ThemeResource SecondaryText}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" /></StackPanel></Grid></Button>
     <Button Grid.Column="1" x:Name="MiniToggle" Click="TogglePlayback" Style="{StaticResource IconButton}" Margin="0,0,4,0" AutomationProperties.Name="播放或暂停"><FontIcon x:Name="MiniPlayGlyph" Glyph="&#xE768;" FontSize="20" /></Button>
    </Grid>
   </Grid>
  </Border>
 </Grid>
</Page>

