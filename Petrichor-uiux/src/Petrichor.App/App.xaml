<Application x:Class="Petrichor.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:Petrichor.App.Controls">
 <Application.Resources><ResourceDictionary>
  <ResourceDictionary.ThemeDictionaries>
   <ResourceDictionary x:Key="Dark">
    <SolidColorBrush x:Key="PageBackground" Color="#0B0B0C" />
    <SolidColorBrush x:Key="Surface" Color="#151517" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="#1C1C1F" />
    <SolidColorBrush x:Key="SecondaryText" Color="#9A9AA2" />
    <SolidColorBrush x:Key="Divider" Color="#26262A" />
   </ResourceDictionary>
   <ResourceDictionary x:Key="Light">
    <SolidColorBrush x:Key="PageBackground" Color="#FAFAFA" />
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="#F0F0F2" />
    <SolidColorBrush x:Key="SecondaryText" Color="#61616A" />
    <SolidColorBrush x:Key="Divider" Color="#E2E2E6" />
   </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
  <!-- 品牌红只用于主行动点（播放、搜索、喜欢）；其余强调交给用户系统强调色 -->
  <SolidColorBrush x:Key="PetrichorAccent" Color="#E84757" />
  <SolidColorBrush x:Key="Accent" Color="{ThemeResource SystemAccentColor}" />
  <Style x:Key="PageTitle" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI Semilight" /><Setter Property="FontSize" Value="20" /><Setter Property="Margin" Value="0,0,0,12" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="{ThemeResource SecondaryText}" /><Setter Property="Margin" Value="0,8,0,4" /></Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI Semilight" /><Setter Property="FontSize" Value="16" /><Setter Property="Margin" Value="0,16,0,8" /></Style>
  <Style x:Key="MetroButton" TargetType="Button"><Setter Property="MinHeight" Value="40" /><Setter Property="MinWidth" Value="40" /><Setter Property="Padding" Value="12,8" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="HorizontalContentAlignment" Value="Center" /></Style>
  <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource MetroButton}"><Setter Property="Background" Value="{StaticResource PetrichorAccent}" /><Setter Property="Foreground" Value="White" /></Style>
  <!-- Button 默认 HorizontalAlignment=Left，放进等分列时会贴左；图标按钮统一 48×48 并在格内居中 -->
  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource MetroButton}"><Setter Property="Width" Value="48" /><Setter Property="Height" Value="48" /><Setter Property="Padding" Value="0" /><Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
  <!-- 左对齐的文字按钮去掉水平内边距，使文字与页面内容左缘对齐 -->
  <Style x:Key="TextButton" TargetType="Button" BasedOn="{StaticResource MetroButton}"><Setter Property="Padding" Value="0,8" /><Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="HorizontalContentAlignment" Value="Left" /></Style>
  <Style x:Key="FooterButton" TargetType="Button" BasedOn="{StaticResource MetroButton}"><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="Margin" Value="0,4,0,0" /></Style>
  <!-- 二级 Pivot：字号低于顶层导航以区分层级；负边距抵消 PivotItem 自带的 12，使标题与内容和页面左缘对齐 -->
  <Style x:Key="SubPivot" TargetType="Pivot"><Setter Property="Margin" Value="-12,0" /><Setter Property="HeaderTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" FontSize="16" /></DataTemplate></Setter.Value></Setter></Style>
  <DataTemplate x:Key="MusicRowTemplate"><Grid Padding="0,8" MinHeight="64"><Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /></Grid.ColumnDefinitions><Border Width="44" Height="44" HorizontalAlignment="Left" Background="{ThemeResource SurfaceAlt}" CornerRadius="2"><Image Source="{Binding Cover}" Stretch="UniformToFill" /></Border><StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{ThemeResource SecondaryText}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" /></StackPanel><FontIcon Grid.Column="2" Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource SecondaryText}" Visibility="{Binding CacheVisibility}" VerticalAlignment="Center" HorizontalAlignment="Right" AutomationProperties.Name="已缓存" ToolTipService.ToolTip="已缓存，可离线播放"/></Grid></DataTemplate>
  <Style x:Key="CoverItemStyle" TargetType="GridViewItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style><DataTemplate x:Key="CoverTemplate"><StackPanel Width="{Binding TileWidth}" Margin="0,0,12,16"><Border Width="{Binding TileWidth}" Height="{Binding TileWidth}" Background="{ThemeResource SurfaceAlt}" CornerRadius="2"><Image Source="{Binding Cover}" Stretch="UniformToFill" /></Border><TextBlock Text="{Binding Title}" FontSize="13" TextWrapping="Wrap" MaxLines="2" Height="36" Margin="0,7,0,2" /><TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{ThemeResource SecondaryText}" TextTrimming="CharacterEllipsis" /></StackPanel></DataTemplate>
 <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/></Style>
<DataTemplate x:Key="CommentTemplate"><controls:CommentCard /></DataTemplate>
  <DataTemplate x:Key="PodcastRowTemplate"><Grid Padding="0,10" MinHeight="76"><Grid.ColumnDefinitions><ColumnDefinition Width="68" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="56" Height="56" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{ThemeResource SurfaceAlt}" CornerRadius="2"><Image Source="{Binding Cover}" Stretch="UniformToFill" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{ThemeResource SecondaryText}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" /><TextBlock Text="{Binding Detail}" Visibility="{Binding DetailVisibility}" FontSize="12" Foreground="{ThemeResource SecondaryText}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" /></StackPanel></Grid></DataTemplate>
  <DataTemplate x:Key="EpisodeRowTemplate"><Grid Padding="0,10" MinHeight="64"><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Badge}" FontSize="13" Foreground="{ThemeResource SecondaryText}" VerticalAlignment="Top" Margin="0,1,0,0" /><StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="{Binding Title}" FontSize="14" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{ThemeResource SecondaryText}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" /></StackPanel><FontIcon Grid.Column="2" Glyph="&#xE768;" FontSize="14" Foreground="{ThemeResource SecondaryText}" VerticalAlignment="Center" HorizontalAlignment="Right" /></Grid></DataTemplate></ResourceDictionary></Application.Resources>
</Application>

